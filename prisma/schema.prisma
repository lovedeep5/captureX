// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}


model Recordings {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String 
  s3_key String
  uuid String @unique
  title String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  comments Comment[]
}

model Comment {
  id        String    @id @default(cuid()) @map("_id")
  content   String
  userId    String    // Clerk user ID
  userName  String    // User's display name
  videoId   String    // UUID of the video
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // For nested comments/replies
  parentId  String?   // ID of parent comment if this is a reply
  parent    Comment?  @relation("CommentToComment", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies   Comment[] @relation("CommentToComment")

  // Likes relation
  likes     Like[]

  // Relation to recording
  recording Recordings @relation(fields: [videoId], references: [uuid], onDelete: Cascade)

  @@index([videoId])
  @@index([parentId])
  @@index([userId])
}

model Like {
  id        String   @id @default(cuid()) @map("_id")
  userId    String   // Clerk user ID
  commentId String
  createdAt DateTime @default(now())

  // Relation to comment
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId]) // Prevent duplicate likes
  @@index([commentId])
  @@index([userId])
}

model activity {
  id          String    @id @default(cuid()) @map("_id")
  userId      String    // Clerk user ID
  type        String    // Type of activity: LOGIN, LOGOUT, RECORDING_CREATED, RECORDING_RENAMED, RECORDING_DELETED, etc.
  details     Json?     // Additional details about the activity (title changes, etc.)
  resourceId  String?   // ID of the related resource (video UUID, comment ID, etc.)
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}